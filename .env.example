# Everything below is optional. A clean clone runs with none of it set:
# data/corpus.json is committed, so the demo needs no network and no accounts.

# Raises the GitHub search rate limit from 10/min to 30/min when re-fetching
# the corpus with `npm run data:refresh`. Needs no scopes; a bare
# read-only token is enough. Never used at request time.
GITHUB_TOKEN=

# Turns the language-model signal from a deterministic stub into a live call.
# It is one signal among fourteen and its confidence is capped at 0.70 before
# the scorer sees it. Every number in the README was produced with this unset.
ANTHROPIC_API_KEY=

# Makes approved decisions execute for real, against a repository YOU OWN.
# Left unset, approving writes to a local log and the interface says so.
# Pointing DOCKET_TARGET_REPO at vercel/next.js is refused outright: those
# issues belong to real people. There is no override.
GITHUB_WRITE_TOKEN=
DOCKET_TARGET_REPO=
